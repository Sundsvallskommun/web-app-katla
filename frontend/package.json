{
  "name": "web-app-katla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "build": "dotenv -e .env.local -- next build",
    "start": "dotenv -e .env.local -- next start",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "next lint --no-cache",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "dotenv -e .env.local -- cross-env ELECTRON_EXTRA_LAUNCH_ARGS=--disable-gpu-sandbox cypress open",
    "cypress:headless": "dotenv -e .env.local -- cross-env ELECTRON_EXTRA_LAUNCH_ARGS=--disable-gpu-sandbox cypress run",
    "test": "jest --watch",
    "test:coverage": "jest --watchAll --coverage",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@hookform/resolvers": "^5.1.1",
    "@next/bundle-analyzer": "^15.3.3",
    "@sk-web-gui/core": "4.1.1",
    "@sk-web-gui/lucide-icon": "^1.1.3",
    "@sk-web-gui/react": "3.0.4",
    "@sk-web-gui/text-editor": "^2.0.2",
    "@tailwindcss/forms": "^0.5.10",
    "@types/sanitize-html": "2.16.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "i18next": "^25.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "next": "15.3.3",
    "next-i18n-router": "^5.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.57.0",
    "react-i18next": "^15.5.2",
    "sanitize-html": "2.17.0",
    "sass": "^1.89.1",
    "sharp": "^0.34.2",
    "underscore.string": "^3.3.6",
    "yup": "^1.6.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/underscore.string": "^0.0.41",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "cypress": "^14.5.4",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "envalid": "^8.0.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest": "^28.13.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "postcss": "^8.5.4",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^13.0.1",
    "prettier": "^3.5.3",
    "swagger-typescript-api": "^13.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ]
}
